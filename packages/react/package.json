{
  "name": "@wulopay/react",
  "version": "1.0.0",
  "description": "React button and hook for WuloPay hosted checkout: your backend creates the session, the shopper pays on WuloPay's secure page.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "wulopay",
    "payments",
    "checkout",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuloPay/wulopay-js.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/WuloPay/wulopay-js/tree/main/packages/react",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
